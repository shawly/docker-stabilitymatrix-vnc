#!/usr/bin/env bash

URL="${1:-}"
PUBLIC_HOSTNAME="${PUBLIC_HOSTNAME:-0.0.0.0}"

if [[ -n "${URL}" ]]; then
	# if URL contains 0.0.0.0 or 127.0.0.1 replace it with PUBLIC_HOSTNAME
	URL="${URL//0.0.0.0/${PUBLIC_HOSTNAME}}"
	URL="${URL//127.0.0.1/${PUBLIC_HOSTNAME}}"

    echo -n "${URL}" | xclip -selection clipboard 2>/dev/null \
        || echo -n "${URL}" | xsel --clipboard --input 2>/dev/null \
        || true
    notify-send \
        --urgency=normal \
        --expire-time=8000 \
        "Link copied to clipboard" \
        "${URL}" 2>/dev/null || true
fi
